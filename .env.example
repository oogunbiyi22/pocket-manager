# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Manager chat uses the Vercel AI SDK. Default rail is Google Gemini (generous
# free tier). Elite tier uses Anthropic Claude when ANTHROPIC_API_KEY is set,
# otherwise falls back to Gemini Pro.
AI_MODEL=gemini-2.0-flash         # free / pro tier model
ELITE_AI_MODEL=                   # optional; defaults: claude-sonnet-4-6 or gemini-1.5-pro

# Google Gemini (free tier — https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic (Elite tier, optional — https://console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenRouter (OPTIONAL test on-ramp — if set, ALL chat routes through it,
# OpenAI-compatible. Lets you validate models before provisioning a real key.
# Leave blank in production.)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_ELITE_MODEL=google/gemini-2.5-pro

# ─── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...       # Stripe Dashboard → Webhooks → signing secret
STRIPE_PRO_PRICE_ID=price_...         # optional — dynamic pricing used if empty
STRIPE_ELITE_PRICE_ID=price_...       # optional — dynamic pricing used if empty

# ─── Email (pitch sending) ────────────────────────────────────────────────────
RESEND_API_KEY=re_...                 # https://resend.com
PITCH_FROM_EMAIL=pitch@yourdomain.com

# ─── Music APIs (all optional — features degrade gracefully if missing) ───────
SONGSTATS_API_KEY=
LASTFM_API_KEY=
TASTEDIVE_API_KEY=
GENIUS_ACCESS_TOKEN=
MUSICFETCH_TOKEN=
MUSIXMATCH_API_KEY=
AIMASTERING_API_KEY=
BANDSINTOWN_APP_ID=

# ─── 21st.dev (AI component generation) ──────────────────────────────────────
API_KEY_21ST=
