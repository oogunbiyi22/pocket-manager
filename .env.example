# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Production: set to "groq" (free) or "anthropic" (paid, best quality)
# Dev/self-hosted: set to "ollama" — requires ollama running locally
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# Groq (free tier — https://console.groq.com)
GROQ_API_KEY=

# Anthropic (Pro = Haiku, Elite = Sonnet — https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Ollama (self-hosted, no API key needed — https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...       # Stripe Dashboard → Webhooks → signing secret
STRIPE_PRO_PRICE_ID=price_...         # optional — dynamic pricing used if empty
STRIPE_ELITE_PRICE_ID=price_...       # optional — dynamic pricing used if empty

# ─── Email (pitch sending) ────────────────────────────────────────────────────
RESEND_API_KEY=re_...                 # https://resend.com
PITCH_FROM_EMAIL=pitch@yourdomain.com

# ─── Music APIs (all optional — features degrade gracefully if missing) ───────
SONGSTATS_API_KEY=
LASTFM_API_KEY=
TASTEDIVE_API_KEY=
GENIUS_ACCESS_TOKEN=
MUSICFETCH_TOKEN=
MUSIXMATCH_API_KEY=
AIMASTERING_API_KEY=
BANDSINTOWN_APP_ID=

# ─── 21st.dev (AI component generation) ──────────────────────────────────────
API_KEY_21ST=
